#!/usr/bin/env bash
# After every commit, append an evidence-only record (commit, files, latest test report) to the AI log.
# It never blocks a commit. Disable with AI_LOG_AUTO=0. The log file changes, so commit it with your next commit.
[ "${AI_LOG_AUTO:-1}" = "0" ] && exit 0
here="$(cd "$(dirname "$0")" && pwd)"
py="$("$here/find-python.sh")"
[ -n "$py" ] && "$py" scripts/ai_log.py auto-commit >/dev/null 2>&1
exit 0
